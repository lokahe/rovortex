# 数据库密码（docker-compose.yml 中 pg 初始化与应用连接串共用）
DB_PASSWORD=change-me-strong-password

# 网关监听端口（容器内，宿主机映射见 docker-compose.yml）
ROVORTEX_PORT=8080

# JWT 签名密钥（HS256）。生产环境必须设置强随机值（32 字节以上）。
# 示例生成：openssl rand -base64 48
ROVORTEX_JWT_SECRET=change-me-to-a-long-random-secret

# Postgres 连接串：
# - 本地开发（compose 的 pg 映射到宿主机时）：localhost:5432
# - 容器内互连：pg:5432（docker-compose.yml 已自动注入，本地跑二进制时才需要这里）
ROVORTEX_DB_URL=postgres://rovortex:change-me-strong-password@localhost:5432/rovortex

# ---- 邮件（Resend）----
# API key：https://resend.com/api-keys ；测试模式只能发给你自己的注册邮箱
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# 发件地址；验证域名前固定用 onboarding@resend.dev
ROVORTEX_MAIL_FROM=onboarding@resend.dev
# 验证邮件里确认链接的域名前缀（对外可访问的 API 地址）
ROVORTEX_VERIFY_URL_BASE=http://localhost:8080
