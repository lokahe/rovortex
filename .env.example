# 数据库密码（docker-compose.yml 中 pg 初始化与应用连接串共用）
DB_PASSWORD=change-me-strong-password

# 网关监听端口（容器内，宿主机映射见 docker-compose.yml）
ROVORTEX_PORT=8080

# Postgres 连接串：
# - 本地开发（compose 的 pg 映射到宿主机时）：localhost:5432
# - 容器内互连：pg:5432（docker-compose.yml 已自动注入，本地跑二进制时才需要这里）
ROVORTEX_DB_URL=postgres://rovortex:change-me-strong-password@localhost:5432/rovortex
