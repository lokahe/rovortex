  "query": "SELECT id, username, username_key, email, email_key, password_hash, status, email_verified, is_admin, created_at, updated_at\n               FROM users\n               WHERE ($1::text IS NULL OR email_key LIKE $1 OR username_key LIKE $1)\n               ORDER BY created_at DESC\n               LIMIT $2 OFFSET $3",
